diff --git a/tests/game/PlayerbotMigrationParser.cpp b/tests/game/PlayerbotMigrationParser.cpp
new file mode 100644
index 00000000..794b18db
--- /dev/null
+++ b/tests/game/PlayerbotMigrationParser.cpp
@@ -0,0 +1,34 @@
+#include "tc_catch2.h"
+#include "Persistence/PlayerbotMigrationMgr.h"
+
+using Playerbot::MigrationDetail::SplitSqlStatements;
+
+TEST_CASE("Playerbot migration SQL parser", "[playerbot][migration]")
+{
+    SECTION("splits and trims ordinary statements")
+    {
+        auto const result = SplitSqlStatements("  SELECT 1;\n INSERT INTO t VALUES (2); ");
+        REQUIRE(result == std::vector<std::string>{"SELECT 1", "INSERT INTO t VALUES (2)"});
+    }
+    SECTION("protects quoted semicolons and comment markers")
+    {
+        auto const result = SplitSqlStatements(
+            "INSERT INTO t VALUES ('a;b', \"c;--d\", `semi;colon`); SELECT 2;");
+        REQUIRE(result.size() == 2);
+        REQUIRE(result[0] == "INSERT INTO t VALUES ('a;b', \"c;--d\", `semi;colon`)");
+        REQUIRE(result[1] == "SELECT 2");
+    }
+    SECTION("removes MySQL comments")
+    {
+        auto const result = SplitSqlStatements(
+            "-- heading; ignored\nSELECT 1; # tail; ignored\n/* block; ignored */ SELECT 2;");
+        REQUIRE(result == std::vector<std::string>{"SELECT 1", "SELECT 2"});
+    }
+    SECTION("supports backslash and doubled delimiter escapes")
+    {
+        auto const result = SplitSqlStatements(
+            "INSERT INTO t VALUES ('it\\'s;a', 'it''s;b', `a``;b`); SELECT 3;");
+        REQUIRE(result.size() == 2);
+        REQUIRE(result[1] == "SELECT 3");
+    }
+}
