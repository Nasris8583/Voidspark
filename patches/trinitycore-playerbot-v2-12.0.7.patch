+std::vector<std::string> SplitSqlStatements(std::string_view sql)
+{
+    enum class State { Normal, SingleQuote, DoubleQuote, Backtick, LineComment, BlockComment };
+    State state = State::Normal;
+    std::vector<std::string> statements;
+    std::string current;
+    current.reserve(sql.size());
+    auto flush = [&]()
+    {
+        size_t const begin = current.find_first_not_of(" \t\r\n");
+        if (begin != std::string::npos)
+        {
+            size_t const end = current.find_last_not_of(" \t\r\n");
+            statements.emplace_back(current.substr(begin, end - begin + 1));
+        }
+        current.clear();
+    };
+
+    for (size_t i = 0; i < sql.size(); ++i)
+    {
+        char const c = sql[i];
+        char const next = i + 1 < sql.size() ? sql[i + 1] : '\0';
+        if (state == State::LineComment)
+        {
+            if (c == '\n') { state = State::Normal; current.push_back('\n'); }
+            continue;
+        }
+        if (state == State::BlockComment)
+        {
+            if (c == '*' && next == '/') { state = State::Normal; ++i; current.push_back(' '); }
+            continue;
+        }
+        if (state == State::Normal)
+        {
+            if (c == '-' && next == '-' &&
+                (i + 2 == sql.size() || std::isspace(static_cast<unsigned char>(sql[i + 2]))))
+            { state = State::LineComment; ++i; continue; }
+            if (c == '#') { state = State::LineComment; continue; }
+            if (c == '/' && next == '*') { state = State::BlockComment; ++i; continue; }
+            if (c == ';') { flush(); continue; }
+            if (c == '\'') state = State::SingleQuote;
+            else if (c == '"') state = State::DoubleQuote;
+            else if (c == '`') state = State::Backtick;
+            current.push_back(c);
+            continue;
+        }
+
+        current.push_back(c);
+        char const delimiter = state == State::SingleQuote ? '\'' :
+            (state == State::DoubleQuote ? '"' : '`');
+        if (c == '\\' && next != '\0') { current.push_back(next); ++i; }
+        else if (c == delimiter)
+        {
+            if (next == delimiter) { current.push_back(next); ++i; }
+            else state = State::Normal;
+        }
+    }
+    flush();
+    return statements;
+}
+
