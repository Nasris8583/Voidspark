diff --git a/dep/boost/CMakeLists.txt b/dep/boost/CMakeLists.txt
index 594249ef..6e1af734 100644
--- a/dep/boost/CMakeLists.txt
+++ b/dep/boost/CMakeLists.txt
@@ -61,6 +61,22 @@ if(NOT Boost_FOUND)
   endif()
 endif()

+# vcpkg's Boost config packages publish Debug and Release imports. With a
+# single-config RelWithDebInfo generator CMake otherwise falls back to the
+# first imported configuration (Debug), mixing debug Boost DLLs with the
+# release CRT. Map only the Boost targets; a global mapping also affects
+# imported dependencies such as MySQL which do not publish a Release config.
+if(WIN32 AND CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
+  get_property(_imported_targets DIRECTORY PROPERTY IMPORTED_TARGETS)
+  foreach(_imported_target IN LISTS _imported_targets)
+    if(_imported_target MATCHES "^Boost::")
+      set_property(TARGET ${_imported_target} PROPERTY
+        MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release)
+    endif()
+  endforeach()
+  unset(_imported_targets)
+endif()
+
 add_library(boost INTERFACE)

 target_link_libraries(boost
